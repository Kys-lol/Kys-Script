-- Slider Min Random ID
SettingsSection:AddSlider({
    Name = "Min Random ID",
    Flag = "MinRandomSlider",
    Min = 1,
    Max = 500,
    Default = Config.MinRandom,
    Decimals = 0,
    Callback = function(value)
        Config.MinRandom = math.floor(value)
    end
})

-- Slider Max Random ID
SettingsSection:AddSlider({
    Name = "Max Random ID",
    Flag = "MaxRandomSlider",
    Min = 500,
    Max = 10000,
    Default = Config.MaxRandom,
    Decimals = 0,
    Callback = function(value)
        Config.MaxRandom = math.floor(value)
    end
})

-- =====================================================
-- AUTO CLEAR LISTENER LOGIC
-- =====================================================
local function setupDeniedListener(remote)
    if remote:IsA("RemoteEvent") then
        remote.OnClientEvent:Connect(function(...)
            if Config.AutoClear then
                if emptyBackpackRemote then
                    emptyBackpackRemote:FireServer()
                    Window:Notify({
                        Title = "Auto Clear",
                        Content = "CollectDenied terdeteksi! Memanggil EmptyBackpack...",
                        Duration = 2,
                        Icon = "lucide:trash-2"
                    })
                end
            end
        end)
    end
end

if remotesFolder then
    local collectDenied = remotesFolder:FindFirstChild("CollectDenied")
    if collectDenied then
        setupDeniedListener(collectDenied)
    end

    remotesFolder.ChildAdded:Connect(function(child)
        if child.Name == "CollectDenied" then
            setupDeniedListener(child)
        end
    end)
end
